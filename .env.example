# ---------------------------------------------------------------------------
# Postgres (required) — Supabase recommended
# Project Settings → Database → connection strings
# Enable extensions in SQL Editor:
#   CREATE EXTENSION IF NOT EXISTS vector;
#   CREATE EXTENSION IF NOT EXISTS pg_trgm;
# See docs/10-setup.md
# ---------------------------------------------------------------------------
# App + migrations (Transaction pooler — works on WSL/IPv4)
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-....pooler.supabase.com:6543/postgres

# Optional. Avoid db.*.supabase.co from WSL (often IPv6-only → ENETUNREACH).
# Use Session pooler if you need a second URL.
# DATABASE_URL_DIRECT=

# ---------------------------------------------------------------------------
# OpenAI (embeddings for ranking; chat only on weak/empty catalog matches)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Admin (password session — not Supabase Auth)
# Generate a secret: openssl rand -hex 32
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SEARCH_CONFIDENCE_THRESHOLD=0.78
