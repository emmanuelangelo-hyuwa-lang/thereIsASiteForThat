# ---------------------------------------------------------------------------
# Postgres (required) — Supabase recommended
# Project Settings → Database → connection strings
# Enable extensions in SQL Editor:
#   CREATE EXTENSION IF NOT EXISTS vector;
#   CREATE EXTENSION IF NOT EXISTS pg_trgm;
# See docs/10-setup.md
# ---------------------------------------------------------------------------
# App / runtime (Transaction pooler, often port 6543)
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-....pooler.supabase.com:6543/postgres

# Migrations / drizzle-kit (Direct connection, port 5432)
DATABASE_URL_DIRECT=postgresql://postgres.xxxx:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# OpenAI (needed for semantic search + embeddings; keyword fallback works without)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Admin (password session — not Supabase Auth)
# Generate a secret: openssl rand -hex 32
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SEARCH_CONFIDENCE_THRESHOLD=0.78
