# ---------------------------------------------------------------------------
# Postgres (required)
# Any Postgres 15+ instance with the pgvector extension available.
# Local WSL Postgres example (see docs/10-setup.md).
# Production: any hosted Postgres with pgvector.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://tias:tias@localhost:5432/thereisasiteforthat

# Optional: use a direct (non-pooled) URL for migrations if DATABASE_URL is pooled
# DATABASE_URL_DIRECT=

# ---------------------------------------------------------------------------
# OpenAI (needed for semantic search + embeddings; keyword fallback works without)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Admin (password session)
# Generate a secret: openssl rand -hex 32
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SEARCH_CONFIDENCE_THRESHOLD=0.78
