# ---------------------------------------------------------------------------
# Postgres (required)
# Any Postgres 15+ instance with the pgvector extension available.
# Local WSL Postgres example (see docs/10-setup.md).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://tias:tias@localhost:5432/thereisasiteforthat

# Optional: use a direct (non-pooled) URL for migrations if DATABASE_URL is pooled
# DATABASE_URL_DIRECT=

# ---------------------------------------------------------------------------
# AI provider (default: Ollama — open source, local)
# ---------------------------------------------------------------------------
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2
# Must match pgvector column (768 for nomic-embed-text)
EMBEDDING_DIMENSIONS=768

# Optional fallback: set AI_PROVIDER=openai and fill these
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
# EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Admin (password session)
# Generate a secret: openssl rand -hex 32
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SEARCH_CONFIDENCE_THRESHOLD=0.78
